{
  "name": "dsh-web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness web UI plugin: replaces the sidebar column with a project-first shell (project dropdown + New Project button), re-skins the page, and rebrands it (AsiaInfo mark + ForgeX).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "smoke": "node scripts/smoke.mjs",
    "smoke:new-project": "node scripts/smoke-new-project.mjs",
    "smoke:git": "node scripts/smoke-git.mjs",
    "harness:folder-route": "node scripts/harness/folder-route.mjs",
    "harness:stage-gate": "node scripts/harness/stage-gate.mjs",
    "harness:project-record": "node scripts/harness/project-record.mjs",
    "harness:stage-tag": "node scripts/harness/tsdown.mjs && node scripts/harness/stage-tag.mjs",
    "harness:folder-flow": "node scripts/harness/tsdown.mjs && node scripts/harness/folder-flow.mjs",
    "harness:new-project-form": "node scripts/harness/tsdown.mjs && node scripts/harness/new-project-form.mjs",
    "harness:lark-panel": "node scripts/harness/tsdown.mjs && node scripts/harness/lark-panel.mjs",
    "harness:lark-login": "node scripts/harness/lark-login.mjs",
    "harness:sidebar-link": "node scripts/harness/tsdown.mjs && node scripts/harness/sidebar-link.mjs",
    "harness:account-dock": "node scripts/harness/tsdown.mjs && node scripts/harness/account-dock.mjs",
    "harness:skills-route": "node scripts/harness/tsdown.mjs && node scripts/harness/skills-route.mjs",
    "harness:skills-install": "node scripts/harness/tsdown.mjs && node scripts/harness/skills-install.mjs",
    "harness:file-route": "node scripts/harness/file-route.mjs",
    "preview:skills-cards": "node --experimental-strip-types scripts/preview/skills-cards.mjs"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  }
}
