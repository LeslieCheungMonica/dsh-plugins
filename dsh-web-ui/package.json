{
  "name": "dsh-web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness web UI plugin: replaces the sidebar column with a project-first shell (project dropdown + New Project button), re-skins the page, and rebrands it (AsiaInfo mark + ForgeX).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:new-project": "node scripts/smoke-new-project.mjs",
    "smoke:git": "node scripts/smoke-git.mjs"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  }
}
