lib/
# The offline harnesses bundle the flow they verify at run time, and generate the
# primitives stub those bundles are aliased to.
scripts/harness/out/
scripts/harness/ui-stub.generated.js
# The visual preview renders itself on demand, and is regenerated by measuring it:
# the page, the bundle it inlines, the screenshots the run leaves behind, and its
# report. `measure-stage-tag.mjs` rebuilds all of them from source, so only the
# sources are committed.
scripts/preview/new-project-dialog.html
scripts/preview/stage-tag.html
scripts/preview/stage-tag-report.json
scripts/preview/stage-tag-*.png
scripts/preview/out/
*.tsbuildinfo
