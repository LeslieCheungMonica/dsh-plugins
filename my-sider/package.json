{
  "name": "my-sider",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness web UI plugin: two operator panels — a docked sidebar whose tabs each open a web address (direct iframe or host relay), and a bottom command panel that runs bash command lines in the current project.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  }
}
